#Practical 8
import numpy as np
from tensorflow.keras.preprocessing import image
from tensorflow.keras.applications.resnet50 import ResNet50, preprocess_input, decode_predictions
from google.colab import files
import matplotlib.pyplot as plt
import cv2
from ultralytics import YOLO

model_resnet = ResNet50(weights='imagenet')

uploaded = files.upload()
image_path = list(uploaded.keys())[0]

img = image.load_img(image_path, target_size=(224,224))
img_array = image.img_to_array(img)
img_array = np.expand_dims(img_array, axis=0)
img_array = preprocess_input(img_array)

predictions = model_resnet.predict(img_array)
results = decode_predictions(predictions, top=3)[0]

print("Top-3 ResNet50 predictions:")
for i in results:
    print(i[1], ":", round(i[2]*100, 2), "%")

model_yolo = YOLO("yolov8n.pt")
results_yolo = model_yolo(image_path)

img_yolo = results_yolo[0].plot()
img_yolo = cv2.cvtColor(img_yolo, cv2.COLOR_BGR2RGB)

plt.imshow(img_yolo)
plt.axis("off")
plt.show()
